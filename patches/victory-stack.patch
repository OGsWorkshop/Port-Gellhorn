+    .unwrap();
+    assert_eq!(psv_wave_range(&sh_w32), (32, 32));
+    let sh_emu = translate_with(
+        &dxbc,
+        TranslateOptions {
+            wave64: Wave64Mode::Emulate,
+        },
+    )
+    .unwrap();
+    assert_eq!(psv_wave_range(&sh_emu), (0, u32::MAX));

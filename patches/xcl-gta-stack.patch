+/// `XCL_NO_WATCHDOG=1`: turn off a retail title's stall watchdog (GTA VI 1.0.2.1, ivall/xcl#505)
+/// – its two aborting branches (heartbeat unchanged for 30 s; an in-flight timestamp too old)
+/// become NOPs – so it can wait for a slow pipeline build instead of ending itself. Each site
+/// is patched only when it holds exactly the expected bytes.
+unsafe fn no_watchdog(base: usize) {
+    use windows_sys::Win32::System::Memory::{VirtualProtect, PAGE_EXECUTE_READWRITE};
+    if std::env::var("XCL_NO_WATCHDOG").map_or(true, |v| v == "0") {
+        return;
+    }
+    for (rva, old) in [(0x2215c70usize, [0x74u8, 0x04]), (0x2215bdc, [0x73, 0x2e])] {
+        let p = (base + rva) as *mut u8;
+        if !crate::gpu::shader::readable(p as usize, 2) || std::slice::from_raw_parts(p, 2) != old {
+            crate::xlog_warn!("XCL_NO_WATCHDOG: +{rva:#x} does not hold {old:02x?}: left alone");
+            continue;
+        }
+        let mut prot = 0u32;
+        if VirtualProtect(p as _, 2, PAGE_EXECUTE_READWRITE, &mut prot) != 0 {
+            *p = 0x90;
+            *p.add(1) = 0x90;
+            VirtualProtect(p as _, 2, prot, &mut prot);
+            crate::xlog_info!("XCL_NO_WATCHDOG: +{rva:#x} {old:02x?} -> [90, 90]");
+        }
+    }
+}

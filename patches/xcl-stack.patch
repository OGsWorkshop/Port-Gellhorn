+    // 20 rows * 16 B = 320 B/vertex: 96 accounted vertices fit (30720 B), but a whole record
+    // is 128 vertices (40960 B) – 4 groups of 32 triangles, 96 vertices each
+    let mut ms20 = ms.clone();
